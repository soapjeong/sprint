    "expo": "~57.0.18",
    "expo-build-properties": "~57.0.15",
    "expo-constants": "~57.0.16",
    "expo-dev-client": "~57.0.16",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.8",
    "expo-router": "~57.0.17",
    "expo-speech": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
